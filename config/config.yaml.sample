# CarrotQuant.Data 全局配置文件示例
# 配置文件加载与优先级 (从高到低):
# 1. 代码程序化修改 cq.data.settings.data_dir 或 cq.data.configure("/path/to/config.yaml") (最高优先级)
# 2. 环境变量 CQDATA_DATA_DIR (覆盖数据存储路径 data_dir)
# 3. 环境变量 CQDATA_CONFIG_PATH (显式指定自定义 YAML 配置文件路径)
# 4. 内置默认值 (data_dir="data", log_dir="logs", log_level="INFO")

# 数据存储根目录 (默认: "data")
data_dir: "data"

# 日志输出目录 (默认: "logs")
log_dir: "logs"

# 日志输出级别 (默认: "INFO"，可选: "DEBUG", "INFO", "WARNING", "ERROR")
log_level: "INFO"


